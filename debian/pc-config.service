[Unit]
Description=Configure the AMD TCO hardware watchdog
Documentation=man:org.freedesktop.systemd1(5) man:modprobe(8)
Requires=dbus.socket
After=dbus.socket

[Service]
Type=oneshot
RemainAfterExit=yes
# PID 1 only applies WatchdogDevice when it starts. Check before setting a timeout.
ExecCondition=/bin/sh -ec 'test "$$(systemctl show --property=WatchdogDevice --value)" = /dev/pc-config-watchdog'
ExecCondition=/usr/sbin/modprobe sp5100_tco
ExecCondition=/usr/bin/udevadm wait --timeout=15 /dev/pc-config-watchdog
ExecStart=/usr/bin/busctl --system set-property org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager RuntimeWatchdogUSec t 300000000
# UINT64_MAX drops the D-Bus override and restores the configured timeout.
ExecStop=/usr/bin/busctl --system set-property org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager RuntimeWatchdogUSec t 18446744073709551615

[Install]
WantedBy=multi-user.target
